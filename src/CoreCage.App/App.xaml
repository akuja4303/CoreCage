<Application x:Class="CoreCage.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:CoreCage.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:LastOkToBrushConverter x:Key="LastOkToBrush" />
        <local:LastOkToGlyphConverter x:Key="LastOkToGlyph" />

        <!-- Palette (dark, WCAG-AA text on panels). Accent = cage-orange, the brand color.
             Measured contrast (WCAG relative-luminance formula, see task-8-report.md):
               Accent (#FF8A3D) on Bg (#14161C)    -> 7.71:1  (passes AA body text, >=4.5:1)
               Accent (#FF8A3D) on Panel (#1D2029) -> 6.94:1  (passes AA body text, >=4.5:1)
               TextLo (#A7ADBB) on Panel           -> 7.24:1
               Good   (#3FB27F) on Panel           -> 6.10:1
               Bad    (#F08A8A) on Panel           -> 6.75:1
             Cage-orange clears 4.5:1 on this dark theme even at body-text size, so it is not
             restricted to large-text/accent use only. -->
        <SolidColorBrush x:Key="Bg"        Color="#FF14161C" />
        <SolidColorBrush x:Key="Panel"     Color="#FF1D2029" />
        <SolidColorBrush x:Key="Rail"      Color="#FF0F111A" />
        <SolidColorBrush x:Key="TextHi"    Color="#FFF5F6FA" />
        <SolidColorBrush x:Key="TextLo"    Color="#FFA7ADBB" />
        <SolidColorBrush x:Key="Focus"     Color="#FFFFD54A" />
        <SolidColorBrush x:Key="Accent"    Color="#FFFF8A3D" />
        <SolidColorBrush x:Key="AccentSoft" Color="#2EFF8A3D" />
        <SolidColorBrush x:Key="Good"      Color="#FF3FB27F" />
        <SolidColorBrush x:Key="Bad"       Color="#FFF08A8A" />

        <!-- Type scale: exactly 5 sizes app-wide, smallest to largest. Every FontSize in the app
             resolves to one of these so text hierarchy reads as intentional, not accidental. -->
        <system:Double x:Key="FontSizeCaption">12</system:Double>
        <system:Double x:Key="FontSizeBody">14</system:Double>
        <system:Double x:Key="FontSizeBodyLg">16</system:Double>
        <system:Double x:Key="FontSizeHeading">20</system:Double>
        <system:Double x:Key="FontSizeDisplay">28</system:Double>

        <!-- 4px spacing grid: every Margin/Padding in the app is a multiple of 4. These scalar steps
             are for single-value contexts (Width/Height/RowDefinition); Margin/Padding thicknesses are
             written inline but always snapped to this grid. -->
        <system:Double x:Key="Space1">4</system:Double>
        <system:Double x:Key="Space2">8</system:Double>
        <system:Double x:Key="Space3">12</system:Double>
        <system:Double x:Key="Space4">16</system:Double>
        <system:Double x:Key="Space5">20</system:Double>
        <system:Double x:Key="Space6">24</system:Double>
        <system:Double x:Key="Space7">28</system:Double>
        <system:Double x:Key="Space8">32</system:Double>

        <!-- Keyboard-focus ring: a visible dashed rectangle in the Focus color, used everywhere in
             place of WPF's near-invisible default focus adorner. Applied (a) automatically to any
             Control that doesn't set its own Style (CheckBox/ComboBox/ListBox/etc. below), and (b)
             explicitly inside every custom keyed Style in this app (BigActionButton, NavItem, and each
             page's local ToolBtn/RowItem/NumBox/ApplyBtn styles) because an element with an explicit
             Style bypasses type-based implicit style lookup, so the blanket rule below wouldn't reach it
             on its own. -->
        <Style x:Key="FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" SnapsToDevicePixels="True"
                                   Stroke="{StaticResource Focus}" StrokeThickness="2"
                                   StrokeDashArray="1 2" RadiusX="4" RadiusY="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Implicit-by-TargetType styles in WPF only match the element's EXACT runtime type — they do
             not cascade from Control down to derived types like CheckBox/ComboBox/ListBox/TextBox. Each
             concrete control type used without its own explicit page-local Style needs its own entry
             here (FocusVisualStyle only — no Template/other setters — so each keeps its normal
             theme-default chrome/visuals, it just gains the visible focus ring). -->
        <Style TargetType="Control">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        </Style>

        <!-- Type scale styles -->
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextLo}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Big, high-contrast, keyboard-focus-visible action button. -->
        <Style x:Key="BigActionButton" TargetType="Button">
            <Setter Property="Height" Value="88" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderThickness="3"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Focus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left-rail navigation item: selected accent bar, hover, keyboard focus ring, accessible name. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextLo}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLg}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Margin="8,2" Padding="12,10">
                            <Border.BorderBrush>Transparent</Border.BorderBrush>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="Bar" Grid.Column="0" Width="3" Height="20" RadiusX="2" RadiusY="2"
                                           Fill="{StaticResource Accent}" Opacity="0" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontSize="{StaticResource FontSizeBodyLg}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource TextHi}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Focus}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
