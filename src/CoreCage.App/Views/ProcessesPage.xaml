<UserControl x:Class="CoreCage.App.Views.ProcessesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderThickness="2" BorderBrush="Transparent" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Focus}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="R" Background="Transparent" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="R" Property="Background" Value="#18FFFFFF" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="R" Property="Background" Value="{StaticResource AccentSoft}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="R" Property="BorderBrush" Value="{StaticResource Focus}" /><Setter TargetName="R" Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Processes" Style="{StaticResource H1}" />

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,12">
            <Button Content="Refresh" Style="{StaticResource ToolBtn}" Background="{StaticResource Accent}"
                    Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh process list" />
            <Button Content="Kill selected" Style="{StaticResource ToolBtn}" Background="#FF9A3B3B"
                    Command="{Binding KillCommand}" AutomationProperties.Name="Kill selected process" />
        </StackPanel>

        <!-- Header -->
        <Grid Grid.Row="2" Margin="12,0,12,4" Visibility="{Binding HasProcesses, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="PROCESS" Style="{StaticResource StatLabel}" />
            <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource StatLabel}" />
            <TextBlock Grid.Column="2" Text="MEMORY" Style="{StaticResource StatLabel}" HorizontalAlignment="Right" />
        </Grid>

        <!-- Empty state: never a silent blank panel -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="12" Padding="32"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="No processes found" Foreground="{StaticResource TextHi}" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="This can happen if CoreCage isn't running elevated. Try Refresh." Foreground="{StaticResource TextLo}"
                           FontSize="{StaticResource FontSizeBody}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ListBox Grid.Row="3" ItemsSource="{Binding Processes}" SelectedItem="{Binding Selected}"
                 Background="{StaticResource Panel}" BorderThickness="0" Foreground="{StaticResource TextHi}"
                 ItemContainerStyle="{StaticResource RowItem}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Visibility="{Binding HasProcesses, Converter={StaticResource BoolToVis}}"
                 AutomationProperties.Name="Process list">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{StaticResource FontSizeBody}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Pid}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextLo}" />
                        <TextBlock Grid.Column="2" Text="{Binding MemoryMb, StringFormat={}{0:F0} MB}" FontSize="{StaticResource FontSizeBody}" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Status / feedback: glyph + color together (not color alone), text unchanged. -->
        <Border Grid.Row="4" Background="{StaticResource Panel}" CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusKind, Converter={StaticResource StatusKindToGlyph}}" VerticalAlignment="Center"
                           Margin="0,0,8,0" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}"
                           Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}"
                           FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
