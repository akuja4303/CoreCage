<UserControl x:Class="CoreCage.App.Views.ProcessesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderThickness="2" BorderBrush="Transparent" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Focus}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="R" Background="Transparent" CornerRadius="6" Padding="12,8" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="R" Property="Background" Value="#18FFFFFF" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="R" Property="Background" Value="#2E3B82F6" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="R" Property="BorderBrush" Value="{StaticResource Focus}" /><Setter TargetName="R" Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Processes" Style="{StaticResource H1}" />

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,12">
            <Button Content="Refresh" Style="{StaticResource ToolBtn}" Background="{StaticResource Accent}"
                    Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh process list" />
            <Button Content="Kill selected" Style="{StaticResource ToolBtn}" Background="#FF9A3B3B"
                    Command="{Binding KillCommand}" AutomationProperties.Name="Kill selected process" />
        </StackPanel>

        <!-- Header -->
        <Grid Grid.Row="2" Margin="12,0,12,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="PROCESS" Style="{StaticResource StatLabel}" />
            <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource StatLabel}" />
            <TextBlock Grid.Column="2" Text="MEMORY" Style="{StaticResource StatLabel}" HorizontalAlignment="Right" />
        </Grid>

        <ListBox Grid.Row="3" ItemsSource="{Binding Processes}" SelectedItem="{Binding Selected}"
                 Background="{StaticResource Panel}" BorderThickness="0" Foreground="{StaticResource TextHi}"
                 ItemContainerStyle="{StaticResource RowItem}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Pid}" FontSize="15" Foreground="{StaticResource TextLo}" />
                        <TextBlock Grid.Column="2" Text="{Binding MemoryMb, StringFormat={}{0:F0} MB}" FontSize="15" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="4" Background="#22FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextHi}" FontSize="14" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
