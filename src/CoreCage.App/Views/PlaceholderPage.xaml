<UserControl x:Class="CoreCage.App.Views.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
            <Border Background="#2E3B82F6" CornerRadius="14" Padding="6,10" Width="60" Height="60"
                    HorizontalAlignment="Center" Margin="0,0,0,18">
                <TextBlock Text="🧩" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" HorizontalAlignment="Center" />
            <Border Background="#22FFFFFF" CornerRadius="12" Padding="6,4" HorizontalAlignment="Center" Margin="0,10,0,14">
                <TextBlock Text="Coming online" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextLo}" FontSize="16"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
