<UserControl x:Class="CoreCage.App.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderThickness="2" BorderBrush="Transparent" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Focus}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="R" Background="Transparent" CornerRadius="6" Padding="16,12" Margin="0,0,0,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="R" Property="Background" Value="#18FFFFFF" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="R" Property="Background" Value="{StaticResource AccentSoft}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="R" Property="BorderBrush" Value="{StaticResource Focus}" /><Setter TargetName="R" Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Profiles" Style="{StaticResource H1}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,12">
            <Button Content="Apply" Style="{StaticResource ToolBtn}" Background="{StaticResource Good}"
                    Command="{Binding ApplyCommand}" AutomationProperties.Name="Apply selected profile" />
            <Button Content="Delete" Style="{StaticResource ToolBtn}" Background="#FF9A3B3B"
                    Command="{Binding DeleteCommand}" AutomationProperties.Name="Delete selected profile" />
            <Button Content="Refresh" Style="{StaticResource ToolBtn}" Background="{StaticResource Accent}"
                    Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh profiles" />
        </StackPanel>

        <!-- Empty state -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="32"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="No saved profiles yet" Foreground="{StaticResource TextHi}" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Profiles you save in the app will appear here to apply in one click." Foreground="{StaticResource TextLo}" FontSize="{StaticResource FontSizeBody}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- List -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}"
                 Background="{StaticResource Panel}" BorderThickness="0" Foreground="{StaticResource TextHi}"
                 ItemContainerStyle="{StaticResource RowItem}" HorizontalContentAlignment="Stretch"
                 Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVis}}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Saved profiles list">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeBodyLg}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextLo}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Status / feedback: glyph + color together (not color alone), text unchanged. -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusKind, Converter={StaticResource StatusKindToGlyph}}" VerticalAlignment="Center"
                           Margin="0,0,8,0" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}"
                           Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}"
                           FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
