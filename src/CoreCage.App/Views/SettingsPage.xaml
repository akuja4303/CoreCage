<UserControl x:Class="CoreCage.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,28">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource H1}" />
            <TextBlock Margin="0,4,0,20" Foreground="{StaticResource TextLo}" FontSize="15" Text="{Binding About}" TextWrapping="Wrap" />

            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="22">
                <StackPanel>
                    <TextBlock Text="APP" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding AppName}" Style="{StaticResource StatValue}" Margin="0,0,0,14" />
                    <TextBlock Text="VERSION" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource StatValue}" FontSize="18" Margin="0,0,0,14" />
                    <TextBlock Text="ELEVATION" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding ElevationText}" Foreground="{StaticResource TextHi}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <TextBlock Text="ENGINE" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding EngineText}" Foreground="{StaticResource TextHi}" FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
