<UserControl x:Class="CoreCage.App.Views.OptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderThickness="2" BorderBrush="Transparent" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Focus}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Optimize" Style="{StaticResource H1}" />
        <TextBlock Grid.Row="1" Margin="0,4,0,20" Foreground="{StaticResource TextLo}" FontSize="15"
                   Text="One click sets your whole rig for gaming. Restore puts everything back exactly as it was." />

        <!-- Status / feedback for every action -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="●" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"
                           Foreground="{StaticResource TextLo}" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextHi}" FontSize="16" TextWrapping="Wrap" />
                <TextBlock Text="  · working…" VerticalAlignment="Center" Foreground="{StaticResource Accent}"
                           FontSize="15" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Gaming Mode active/inactive readout: read once (on activation/after apply), never bound to a poll -->
        <TextBlock Grid.Row="3" Margin="4,0,0,22" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextLo}">
            <Run Text="Gaming Mode: " />
            <Run Text="{Binding GamingStatusText, Mode=OneWay}" />
        </TextBlock>

        <!-- Core Cage: reserve top cores for the game, cage background processes onto the rest. -->
        <Border Grid.Row="4" Background="{StaticResource Panel}" CornerRadius="10" Padding="18,14" Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Core Cage" VerticalAlignment="Center" FontSize="15"
                          Foreground="{StaticResource TextHi}"
                          IsChecked="{Binding CoreCageEnabled}"
                          IsEnabled="{Binding CanEditCoreCageSettings}"
                          AutomationProperties.Name="Core Cage enabled"
                          AutomationProperties.HelpText="Reserve top cores for the game and confine background processes to the rest" />
                <TextBlock Text="Reserve cores:" VerticalAlignment="Center" Margin="20,0,10,0" FontSize="14"
                           Foreground="{StaticResource TextLo}" />
                <ComboBox Width="70" VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableReservedCoreCounts}"
                          SelectedItem="{Binding CoreCageReservedCores}"
                          IsEnabled="{Binding CanEditCoreCageSettings}"
                          AutomationProperties.Name="Core Cage reserved core count"
                          AutomationProperties.HelpText="How many logical cores to reserve for the game" />
            </StackPanel>
        </Border>

        <!-- Tweak Ledger: what's active + what it earned you. "Prove it" runs a real before/after
             PresentMon A/B benchmark against whatever's currently active. -->
        <Border Grid.Row="5" Background="{StaticResource Panel}" CornerRadius="10" Padding="18,14" Margin="0,0,0,22">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tweak Ledger" VerticalAlignment="Center" FontSize="16"
                               FontWeight="SemiBold" Foreground="{StaticResource TextHi}" />
                    <Button Grid.Column="1" Content="Prove it" Style="{StaticResource ToolBtn}"
                            Background="{StaticResource Accent}" Command="{Binding ProveItCommand}"
                            AutomationProperties.Name="Prove it"
                            AutomationProperties.HelpText="Run a before/after PresentMon benchmark against the currently active tweaks" />
                </Grid>

                <!-- Empty state -->
                <TextBlock Text="No tweaks applied yet — hit Gaming Mode" FontSize="14"
                           Foreground="{StaticResource TextLo}"
                           Visibility="{Binding IsLedgerEmpty, Converter={StaticResource BoolToVis}}" />

                <!-- Rows: tweak name + Active/inactive + measured delta or "not yet benchmarked" -->
                <ItemsControl ItemsSource="{Binding LedgerRows}"
                              Visibility="{Binding HasLedgerRows, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" Focusable="True" KeyboardNavigation.IsTabStop="True"
                                  AutomationProperties.Name="{Binding DisplayName}"
                                  AutomationProperties.HelpText="{Binding DeltaText}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="15"
                                           Foreground="{StaticResource TextHi}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="inactive" />
                                            <Setter Property="Foreground" Value="{StaticResource TextLo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Active}" Value="True">
                                                    <Setter Property="Text" Value="ACTIVE" />
                                                    <Setter Property="Foreground" Value="{StaticResource Good}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding DeltaText}" FontSize="14"
                                           Foreground="{StaticResource TextLo}" HorizontalAlignment="Right"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- The two modes: Gaming, Restore. CoreCage.App is gaming-only; no other mode here. -->
        <Grid Grid.Row="6" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Gaming Mode" Style="{StaticResource BigActionButton}"
                    Background="{StaticResource Good}" Command="{Binding GamingCommand}"
                    AutomationProperties.HelpText="Apply gaming performance tweaks" />
            <Button Grid.Column="2" Content="Restore Everything" Style="{StaticResource BigActionButton}"
                    Background="#FF0F766E" Command="{Binding RestoreCommand}"
                    AutomationProperties.HelpText="Undo every change CoreCage made" />
        </Grid>
    </Grid>
</UserControl>
