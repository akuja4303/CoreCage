<UserControl x:Class="CoreCage.App.Views.OptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderThickness="2" BorderBrush="Transparent">
                            <Border.Padding>
                                <Thickness Left="{StaticResource Space4}" Top="{StaticResource Space2}" Right="{StaticResource Space4}" Bottom="{StaticResource Space2}" />
                            </Border.Padding>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Focus}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Spacing tokens (review ITEM-3): the app-wide 4px grid (Space1..Space8, App.xaml) is wired into
         this page's own margins/padding below as a real, demonstrable (if partial) spacing system —
         see the note on the Space* resources in App.xaml for scope. -->
    <Grid>
        <Grid.Margin>
            <Thickness Left="{StaticResource Space8}" Top="{StaticResource Space7}" Right="{StaticResource Space8}" Bottom="{StaticResource Space7}" />
        </Grid.Margin>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Optimize" Style="{StaticResource H1}" />
        <TextBlock Grid.Row="1" Foreground="{StaticResource TextLo}" FontSize="{StaticResource FontSizeBody}"
                   Text="One click sets your whole rig for gaming. Restore puts everything back exactly as it was.">
            <TextBlock.Margin>
                <Thickness Top="{StaticResource Space1}" Bottom="{StaticResource Space5}" />
            </TextBlock.Margin>
        </TextBlock>

        <!-- Status / feedback for every action. Glyph + color together (not color alone) so
             success/failure reads for colorblind users too; the text message itself is unchanged. -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10">
            <Border.Padding>
                <Thickness Left="{StaticResource Space5}" Top="{StaticResource Space4}" Right="{StaticResource Space5}" Bottom="{StaticResource Space4}" />
            </Border.Padding>
            <Border.Margin>
                <Thickness Bottom="{StaticResource Space4}" />
            </Border.Margin>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusKind, Converter={StaticResource StatusKindToGlyph}}" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeBodyLg}" FontWeight="Bold"
                           Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}">
                    <TextBlock.Margin>
                        <Thickness Right="{StaticResource Space3}" />
                    </TextBlock.Margin>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}"
                           FontSize="{StaticResource FontSizeBodyLg}" TextWrapping="Wrap" />
                <TextBlock Text="  · working…" VerticalAlignment="Center" Foreground="{StaticResource Accent}"
                           FontSize="{StaticResource FontSizeBody}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Gaming Mode active/inactive readout: read once (on activation/after apply), never bound to a poll -->
        <TextBlock Grid.Row="3" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                   Foreground="{StaticResource TextLo}">
            <TextBlock.Margin>
                <Thickness Left="{StaticResource Space1}" Bottom="{StaticResource Space5}" />
            </TextBlock.Margin>
            <Run Text="Gaming Mode: " />
            <Run Text="{Binding GamingStatusText, Mode=OneWay}" />
        </TextBlock>

        <!-- Core Cage: reserve top cores for the game, cage background processes onto the rest. -->
        <Border Grid.Row="4" Background="{StaticResource Panel}" CornerRadius="10">
            <Border.Padding>
                <Thickness Left="{StaticResource Space5}" Top="{StaticResource Space4}" Right="{StaticResource Space5}" Bottom="{StaticResource Space4}" />
            </Border.Padding>
            <Border.Margin>
                <Thickness Bottom="{StaticResource Space5}" />
            </Border.Margin>
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Core Cage" VerticalAlignment="Center" FontSize="{StaticResource FontSizeBodyLg}"
                          Foreground="{StaticResource TextHi}"
                          IsChecked="{Binding CoreCageEnabled}"
                          IsEnabled="{Binding CanEditCoreCageSettings}"
                          AutomationProperties.Name="Core Cage enabled"
                          AutomationProperties.HelpText="Reserve top cores for the game and confine background processes to the rest" />
                <TextBlock Text="Reserve cores:" VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource TextLo}">
                    <TextBlock.Margin>
                        <Thickness Left="{StaticResource Space5}" Right="{StaticResource Space2}" />
                    </TextBlock.Margin>
                </TextBlock>
                <ComboBox Width="70" VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableReservedCoreCounts}"
                          SelectedItem="{Binding CoreCageReservedCores}"
                          IsEnabled="{Binding CanEditCoreCageSettings}"
                          AutomationProperties.Name="Core Cage reserved core count"
                          AutomationProperties.HelpText="How many logical cores to reserve for the game" />
            </StackPanel>
        </Border>

        <!-- Tweak Ledger: what's active + what it earned you. "Prove it" runs a real before/after
             PresentMon A/B benchmark against whatever's currently active. -->
        <Border Grid.Row="5" Background="{StaticResource Panel}" CornerRadius="10">
            <Border.Padding>
                <Thickness Left="{StaticResource Space5}" Top="{StaticResource Space4}" Right="{StaticResource Space5}" Bottom="{StaticResource Space4}" />
            </Border.Padding>
            <Border.Margin>
                <Thickness Bottom="{StaticResource Space5}" />
            </Border.Margin>
            <StackPanel>
                <Grid>
                    <Grid.Margin>
                        <Thickness Bottom="{StaticResource Space2}" />
                    </Grid.Margin>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tweak Ledger" VerticalAlignment="Center" FontSize="{StaticResource FontSizeBodyLg}"
                               FontWeight="SemiBold" Foreground="{StaticResource TextHi}" />
                    <Button Grid.Column="1" Content="Prove it" Style="{StaticResource ToolBtn}"
                            Background="{StaticResource Accent}" Command="{Binding ProveItCommand}"
                            AutomationProperties.Name="Prove it"
                            AutomationProperties.HelpText="Run a before/after PresentMon benchmark against the currently active tweaks" />
                </Grid>

                <!-- Empty state -->
                <TextBlock Text="No tweaks applied yet — hit Gaming Mode" FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource TextLo}"
                           Visibility="{Binding IsLedgerEmpty, Converter={StaticResource BoolToVis}}" />

                <!-- Rows: tweak name + Active/inactive + measured delta or "not yet benchmarked" -->
                <ItemsControl ItemsSource="{Binding LedgerRows}"
                              Visibility="{Binding HasLedgerRows, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Grid isn't a Control, so App.xaml's implicit Control FocusVisualStyle rule
                                 doesn't reach it (same class of bug already fixed for CheckBox/ComboBox/
                                 etc. — review IMPORTANT-2); FocusVisualStyle is a FrameworkElement property
                                 though, so setting it explicitly here does give this focusable row a
                                 visible keyboard focus ring. -->
                            <Grid Focusable="True" KeyboardNavigation.IsTabStop="True"
                                  FocusVisualStyle="{StaticResource FocusVisual}"
                                  AutomationProperties.Name="{Binding DisplayName}"
                                  AutomationProperties.HelpText="{Binding DeltaText}">
                                <Grid.Margin>
                                    <Thickness Top="{StaticResource Space1}" Bottom="{StaticResource Space1}" />
                                </Grid.Margin>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="{StaticResource FontSizeBodyLg}"
                                           Foreground="{StaticResource TextHi}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="inactive" />
                                            <Setter Property="Foreground" Value="{StaticResource TextLo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Active}" Value="True">
                                                    <Setter Property="Text" Value="ACTIVE" />
                                                    <Setter Property="Foreground" Value="{StaticResource Good}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding DeltaText}" FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{StaticResource TextLo}" HorizontalAlignment="Right"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- The two modes: Gaming, Restore. CoreCage.App is gaming-only; no other mode here. -->
        <Grid Grid.Row="6" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- Width is GridLength, not the Double the Space* tokens are typed as (no implicit
                     Double->GridLength conversion through a markup extension) — left as a literal,
                     still on the 4px grid (Space4). -->
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Gaming Mode" Style="{StaticResource BigActionButton}"
                    Background="{StaticResource Good}" Command="{Binding GamingCommand}"
                    AutomationProperties.Name="Gaming Mode"
                    AutomationProperties.HelpText="Apply gaming performance tweaks" />
            <Button Grid.Column="2" Content="Restore Everything" Style="{StaticResource BigActionButton}"
                    Background="#FF0F766E" Command="{Binding RestoreCommand}"
                    AutomationProperties.Name="Restore everything"
                    AutomationProperties.HelpText="Undo every change CoreCage made" />
        </Grid>
    </Grid>
</UserControl>
