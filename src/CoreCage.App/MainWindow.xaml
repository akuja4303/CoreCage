<Window x:Class="CoreCage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CoreCage.App"
        xmlns:views="clr-namespace:CoreCage.App.Views"
        Title="CoreCage"
        Height="700" Width="1020"
        MinHeight="580" MinWidth="840"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI"
        FontSize="16"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- The content area picks the right page for whichever group VM is current. -->
        <DataTemplate DataType="{x:Type local:OptimizeViewModel}"><views:OptimizePage /></DataTemplate>
        <DataTemplate DataType="{x:Type local:MonitorViewModel}"><views:MonitorPage /></DataTemplate>
        <DataTemplate DataType="{x:Type local:TuneViewModel}"><views:TunePage /></DataTemplate>
        <DataTemplate DataType="{x:Type local:SystemViewModel}"><views:SystemPage /></DataTemplate>
        <DataTemplate DataType="{x:Type local:ProcessesViewModel}"><views:ProcessesPage /></DataTemplate>
        <DataTemplate DataType="{x:Type local:ProfilesViewModel}"><views:ProfilesPage /></DataTemplate>
        <DataTemplate DataType="{x:Type local:SettingsViewModel}"><views:SettingsPage /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation rail -->
        <Border Grid.Column="0" Background="{StaticResource Rail}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,16">
                    <TextBlock Text="CoreCage" Foreground="{StaticResource TextHi}" FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="Gaming" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextLo}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         HorizontalContentAlignment="Stretch"
                         KeyboardNavigation.DirectionalNavigation="Cycle"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <!-- Content: the selected group's page -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" />
    </Grid>
</Window>
